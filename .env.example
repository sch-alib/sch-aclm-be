APP_NAME=Certificate Automation
API_PREFIX=/api/v1
# Required: generate a unique, unpredictable signing secret (32+ characters recommended).
JWT_SECRET=
# Required only on first startup with a new database: admin bootstrap password (12+ characters).
BOOTSTRAP_ADMIN_PASSWORD=
# Required before attempting deployment; keep this secret outside source control.
PFX_PASSWORD=
ACCESS_TOKEN_MINUTES=720
DATABASE_PATH=./certificate_automation.db
ARTIFACTS_DIRECTORY=./artifacts

DIGICERT_MODE=mock
DIGICERT_API_BASE=https://www.digicert.com/services/v2
DIGICERT_API_KEY=
DIGICERT_TIMEOUT_SECONDS=60
DIGICERT_MAX_RETRIES=3
DIGICERT_RETRY_BACKOFF_SECONDS=1
DIGICERT_POLL_SECONDS=3
DIGICERT_POLL_ATTEMPTS=20
DIGICERT_SERVER_PLATFORM_ID=2
DIGICERT_DEFAULT_PRODUCT_NAME_ID=ssl_plus
# Set this to an existing, validated organization ID in your CertCentral account.
DIGICERT_DEFAULT_ORGANIZATION_ID=0
DIGICERT_DEFAULT_VALIDITY_DAYS=199

# Background checks query order details only; no reissue or deployment.
ISSUANCE_CHECK_ENABLED=true
ISSUANCE_CHECK_INTERVAL_SECONDS=60
ISSUANCE_CHECK_TICK_SECONDS=10
ISSUANCE_CHECK_MAX_FAILURES=5
ISSUANCE_CHECK_MAX_BACKOFF_SECONDS=3600

IIS_DRY_RUN=true
